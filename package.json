{
  "name": "momos-one",
  "private": true,
  "version": "0.1.0",
  "description": "Multimodal system-1 in the browser: a finite schema scored from an image in one batched wasm pass, with a probability per field",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-restart": "node e2e/restart-dev.mjs",
    "check-dev": "node e2e/check-dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "node e2e/decision-smoke.mjs",
    "smoke:webmcp": "node e2e/webmcp-smoke.mjs",
    "samples": "node e2e/make-samples.mjs",
    "check-evidence": "node e2e/check-evidence.mjs",
    "bench": "node e2e/bench-decision.mjs",
    "shots": "node e2e/ui-shots.mjs",
    "check-pages": "node e2e/isolation-probe.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.63.0",
    "typescript": "^5.5.4",
    "vite": "^5.3.4",
    "webmcp-types": "^0.1.9"
  }
}
